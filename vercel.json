{
  "buildCommand": "bash build.sh",
  "outputDirectory": "dist",
  "installCommand": "",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/rundown",
      "destination": "/episodes?s=rundown"
    },
    {
      "source": "/npa",
      "destination": "/episodes?s=npa"
    },
    {
      "source": "/ai",
      "destination": "/episodes?s=ai"
    },
    {
      "source": "/interviews",
      "destination": "/episodes?s=interview"
    }
  ]
}
